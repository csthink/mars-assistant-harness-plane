        </mxCell>
        <mxCell id="s4" value="修正语义（贯穿全旅程的两条路径）" style="rounded=1;html=1;fillColor=#f7f7f7;strokeColor=#d0d0d0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="1155" width="1220" height="350" as="geometry" />
        </mxCell>
        <mxCell id="n0a" value="由人创建新仓或选择存量 Git 仓库&lt;br&gt;保留已有代码、历史与工具配置&lt;br&gt;机制只引导，不代建" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="50" y="88" width="240" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n0b" value="HarnessPlane 安装形态由机制区三树提供&lt;br&gt;check 只读；init 经授权安全接入&lt;br&gt;fix 仅授权修复本产品拥有的接入产物" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="340" y="88" width="340" height="62" as="geometry" />
        </mxCell>
        <mxCell id="note0" value="空规格基线可接入；安装成功不等于正式 feature 来源就绪。&lt;br&gt;冲突或未知归属不覆盖；正式 feature 仍经 Stage 0/1/2 定稿或冻结。&lt;br&gt;本仓创始实例与历史不复制给下游；接入工具未等同完整产品交付。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="730" y="88" width="480" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="用户开启对话&lt;br&gt;（任意 LLM / Coding Agent）" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="50" y="221" width="175" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="内置引导 skill · 现行模板&lt;br&gt;新建目标 / 可核存量事实&lt;br&gt;用户确认产品取舍" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="265" y="221" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="proposal 候选&lt;br&gt;注明来源与待确认项&lt;br&gt;不伪造历史定稿" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="505" y="221" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="插件 B · 异源评审&lt;br&gt;默认开 · 可显式关（留痕）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="695" y="221" width="205" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="Human 定稿&lt;br&gt;FINALIZED" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="950" y="221" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="起草 spec&lt;br&gt;（锚定定稿 proposal）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="50" y="354" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="spec 候选" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="320" y="354" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="插件 B · 异源评审&lt;br&gt;默认开 · 可显式关（留痕）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="520" y="354" width="205" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="Human Freeze&lt;br&gt;FROZEN rN" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="775" y="354" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="起草 milestones&lt;br&gt;（锚定冻结 spec）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="50" y="487" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n11" value="milestones 候选" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="320" y="487" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n12" value="插件 B · 异源评审&lt;br&gt;默认开 · 可显式关（留痕）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="520" y="487" width="205" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n13" value="Human Freeze&lt;br&gt;任务在名单中出生（唯一任务 ID）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="775" y="487" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n30" value="hotfix 入口：产品内登记出生（FR-19，登记首次成功持久化生成不可变登记标识）；不经名单出生、不适用 FR-18 四件锚；接纳同受 FR-32 有界并发约束" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="614" width="560" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n14" value="&lt;b&gt;Human 选定任务（有界并发，FR-32）&lt;/b&gt;&lt;br&gt;机械约束 = 依赖满足 + 并发容量（FR-32）&lt;br&gt;Milestone 编号是身份不是顺序，可跨 Milestone 交错推进&lt;br&gt;类型 feature / hotfix（FR-15）" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="684" width="290" height="98" as="geometry" />
        </mxCell>
        <mxCell id="n15" value="正式 feature 四件来源（FR-18）&lt;br&gt;同仓定稿 proposal + 冻结 spec/milestones&lt;br&gt;唯一任务条目 + 适用冻结 Decision&lt;br&gt;接入成功不等于来源就绪&lt;br&gt;hotfix：登记标识（FR-19），不适用四件来源" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="684" width="230" height="98" as="geometry" />
        </mxCell>
        <mxCell id="n16" value="UI Gate（本 Milestone 含 UI 变更时）&lt;br&gt;低保真（可自包含 HTML）→ 高保真，各经独立视觉评审 + Human 冻结&lt;br&gt;评审面 = 文档与继承一致性，审美归 Human 终裁&lt;br&gt;无 UI 变更：记 not applicable 直接进入内环" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="630" y="690" width="330" height="86" as="geometry" />
        </mxCell>
        <mxCell id="n18" value="&lt;b&gt;Human 终止总闸（FR-27）&lt;/b&gt;&lt;br&gt;任意节点可 Close Task&lt;br&gt;方向单向 · 如实留痕&lt;br&gt;不改 v5 拓扑" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1000" y="690" width="210" height="86" as="geometry" />
        </mxCell>
        <mxCell id="n17" value="&lt;b&gt;任务生命周期内环 = MVP_Workflow_v5.drawio 拓扑（唯一权威，本图不复述内部）&lt;/b&gt;&lt;br&gt;Define Task → Review Definition〔插件·配置见 §8〕→ Human Gate 冻结任务定义 → Implement → Verify → Validate Change〔插件·配置见 §8〕→ Human Gate → Publish&lt;br&gt;含三处 bounded autonomous budget loop；治理自举期由人工按同一拓扑执行，M-04 起由 harness CLI 机械执行" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#1f1f1f;strokeColor=#000000;fontColor=#ffffff;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="806" width="910" height="104" as="geometry" />
        </mxCell>
        <mxCell id="n20" value="公共 Decision 暂停机制&lt;br&gt;暴露跨任务技术问题 → 暂停 → Decision 出生冻结（文法归 gov-t25）→ 任务引用后恢复" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1000" y="806" width="210" height="104" as="geometry" />
        </mxCell>
        <mxCell id="n19" value="&lt;b&gt;任务分支物理层（branch-per-task）&lt;/b&gt;&lt;br&gt;CLI 原子接纳：Task + Task Branch + 独立 worktree 绑定，失败不暴露半成品 Task（FR-15/22，feature-t0 承载）&lt;br&gt;候选变更在 Task Branch → Publish = 推分支 + 开 MR/PR（FR-29）→ Human 决定合并，可按当批交付授权委托执行（GitLab FF / GitHub merge commit）&lt;br&gt;main 的服务端保护/免费例外见 §6.4 · MR/PR-only；MR/PR 合并 = Published 之后的主线接纳；决定归 Human；分支命名自由，治理定位基准用提交 SHA&lt;br&gt;人工期：cst-ship 指导 Agent 使用已有工具交付；不安全的工作区清理保留并报告；发起 MR/PR 仅发布；$resume 只读（交接协议 §5/§6.7）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="50" y="940" width="910" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n21" value="终态（Published / Closed，FR-32）&lt;br&gt;→ 容量释放；未终态数低于上限时选择下一任务" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="1070" width="220" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n22" value="Milestone 完成判定&lt;br&gt;（独立于编号顺序，由 Human 判）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="330" y="1070" width="300" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n23" value="端到端验收" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="690" y="1070" width="200" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n24" value="&lt;b&gt;路径一 · 修正流水线（proposal / spec / milestones / Layer 2 机制设计 / UI 设计冻结件〔低保真 · 高保真〕）&lt;/b&gt;&lt;br&gt;变更发现 → 直改候选 + Changelog → 插件 A 机械提醒器〔可拔 · 事实 + 红绿 · 非门〕→ Human 裁量 → 插件 B 异源评审〔可拔；UI 冻结件取独立视觉评审，评审面 = 文档与继承一致性〕→ Human 终裁 re-Freeze&lt;br&gt;目标成本：一次直改 + 一次拍板（任务拆分 / 增任务 / 关任务 / 条目更正）&lt;br&gt;生效 = 对应上游件形成新冻结修订（proposal 定稿 / spec Freeze / milestones Freeze / UI re-Freeze 同型）&lt;br&gt;分级（§7.5）：对齐级〔语义零变化；插件 B 默认关，Changelog 简式〕/ 语义级〔按 §8 默认〕· 变更集（§7.6）：同一触发事实的多文件修正 = 一份 Changelog + 一次终裁 + 一次冻结提交" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="1190" width="550" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n25" value="&lt;b&gt;路径二 · 逐层上修链&lt;/b&gt;&lt;br&gt;执行层（低保真 / 高保真 / 前后端代码）发现上游缺失、冗余或错误 → Human 选形态（就地修正 或 开修复任务，不设判别标准）→ 上游走路径一 → 受影响清单登记（提醒器第三项事实）→ Human 排期&lt;br&gt;硬规则：任务再施工前，上游锚必须指向上游当前冻结修订" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="670" y="1190" width="540" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n26" value="依赖锚链条：proposal → spec → milestones；spec → 低保真（html / 设计文档）→ 高保真 → 前端代码；spec → 后端代码&lt;br&gt;architecture 与 design 为非冻结工程材料（§4 / §6.2）；prototype 授权建立并对照 spec，不入 UI 冻结链" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="50" y="1326" width="550" height="56" as="geometry" />
        </mxCell>
        <mxCell id="n27" value="插件默认配置见正文 §8；Human 终裁不可拔，插件结论不绑定 Human。&lt;br&gt;SC-6：保留实际开关、运行/未运行、重新启用时点、Verdict/Findings/reservation 与 Human 决策；历史不改写，不计算或传播保证等级。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="670" y="1326" width="540" height="56" as="geometry" />
        </mxCell>
        <mxCell id="n28" value="Verify 中适用的预定义确定性检查：FAIL 不可带保留绕过；修复、按修正程序改检查后重跑，或 Close Task。&lt;br&gt;layout / manifest 是人工可选 lint，不接提交面与治理 CI；适用产品 Verify 仍须完成。&lt;br&gt;平台治理绑定已退役；GitLab 期间原配置/保护保持；GitHub 私有免费边界见 §6.4，GitLab 退役事实见 records/GITLAB_CI_ENFORCEMENT.md。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#b85450;fontSize=10;align=left;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="50" y="1398" width="1160" height="56" as="geometry" />
        </mxCell>
