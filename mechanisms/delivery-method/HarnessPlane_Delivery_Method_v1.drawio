        <mxCell id="e7" value="整改环（Human 处置）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="n4" target="n3"><mxGeometry relative="1" as="geometry" /></mxCell>
